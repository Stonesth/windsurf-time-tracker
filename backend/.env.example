# Chemin vers le fichier de clé de service Firebase (relatif à src/config)
GOOGLE_APPLICATION_CREDENTIALS=../config/service-account-key.json

# URL de la base de données Firebase
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Port du serveur (optionnel)
PORT=3001

# Clé API secrète pour automatisation externe (curl, shortcuts, scripts)
API_SECRET_KEY=votre_cle_api_secrete_personnalisee

# Email du compte utilisateur à associer par défaut lors d'un appel par clé API
DEFAULT_USER_EMAIL=pierre.thonon@gmail.com
